# =============================================================================
# Unimble Web App — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex — Backend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# -----------------------------------------------------------------------------
# Clerk — Authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Onboarding cookie signing (falls back to CLERK_SECRET_KEY if not set)
ONBOARDING_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# Sentry — Error Tracking
# Get DSN from: https://sentry.io → unimble org → javascript-nextjs project → Settings → SDK Setup
# Get auth token from: https://sentry.io → Settings → Auth Tokens → Create token (project:write scope)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://6fa49519ddc712e4f9bc0b62225a0723@o4511468734578688.ingest.us.sentry.io/4511468778749952
SENTRY_ORG=unimble
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# PostHog — Product Analytics
# Get project API key from: https://us.posthog.com/project/settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
